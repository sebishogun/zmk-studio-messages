// nanopb encode/decode hints. Without these, string + repeated fields
// turn into pb_callback_t which complicates the firmware C side.
//
// MacroSlot is a fixed shape: ≤64 bindings per slot (matches
// CONFIG_ZMK_STUDIO_MACRO_SLOT_BINDINGS_MAX default), label up to 16
// chars (room for "slot_<N>" + null + future tags). 64 was picked
// over the original 16 so paste-style phrases ("if err != nil { return err }")
// fit without forcing the user to switch to static macros, while
// keeping the per-slot static reservation under ~1 KB
// (64 × ~16 B/binding = ~1 KB) — comfortable on nRF52840 SRAM.

zmk.behaviors.MacroSlot.label max_size:16 fixed_length:false
zmk.behaviors.MacroSlot.bindings max_count:64

zmk.behaviors.SetMacroSlotRequest.bindings max_count:64
